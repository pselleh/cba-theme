{
  "name": "@pselleh/cba-brand",
  "version": "1.0.0",
  "description": "CBA custom Ulmo brand package for Open edX MFEs",
  "main": "dist/core.css",
  "files": [
    "dist",
    "core.css",
    "light.css",
    "paragon"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:scss",
    "build:tokens": "paragon build-tokens --source ./paragon/tokens/ --build-dir ./paragon/build -t light",
    "build:scss": "paragon build-scss --corePath ./paragon/core.scss --themesPath ./paragon/build/themes --source"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pselleh/cba-theme.git"
  },
  "author": "CBA",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@openedx/paragon": "^23.0.0"
  }
}
